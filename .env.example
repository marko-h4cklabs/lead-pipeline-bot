# Google Sheets (ID iz URL-a Sheeta: /spreadsheets/d/SHEET_ID/edit)
GOOGLE_SHEETS_ID=

# Autentifikacija — Application Default Credentials (ADC)
# GitHub Actions: WIF konfiguriran u workflowima, nema JSON ključa.
# Lokalno — jedna od dvije opcije:
#   1. gcloud auth application-default login \
#        --scopes=https://www.googleapis.com/auth/spreadsheets
#   2. GOOGLE_APPLICATION_CREDENTIALS=/putanja/do/sa_key.json
GOOGLE_APPLICATION_CREDENTIALS=

# Google Places API key (iz Google Cloud Console)
GOOGLE_PLACES_API_KEY=

# Anthropic API key (za opis-sažetak u verify fazi)
ANTHROPIC_API_KEY=

# GitHub Pages base URL (za generiranje link kolone u Sheetu)
# Format: https://USERNAME.github.io/REPO_NAME/
GITHUB_PAGES_BASE=https://YOUR_USERNAME.github.io/lead-scraper-august/

# Webapp: Google OAuth Client ID (client-side, nije tajna — može biti u kodu)
# Kreirati u GCP: APIs & Services > Credentials > OAuth 2.0 Client ID (Web application)
# Authorized JavaScript origins: https://USERNAME.github.io
GOOGLE_OAUTH_CLIENT_ID=

# Opcioni limiti (defaults su postavljeni u kodu)
MAX_NEW_PER_RUN=80
MAX_VERIFY_PER_RUN=80
MIN_EMPLOYEES=5
MIN_YEARS=2
